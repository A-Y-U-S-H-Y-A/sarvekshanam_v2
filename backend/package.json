{
  "name": "sarvekshanam-backend",
  "version": "1.0.0",
  "description": "Sarvekshanam – Multi-system Security Operations Platform (Backend)",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/initDb.js",
    "start": "node src/server.js",
    "predev": "node scripts/initDb.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "jest --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit --runInBand",
    "test:unit": "jest tests/unit --forceExit --runInBand",
    "test:integration": "jest tests/integration --forceExit --runInBand",
    "make-admin": "node scripts/makeAdmin.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/groq": "^1.3.1",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-openidconnect": "^0.1.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "read-excel-file": "^9.3.12",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "write-excel-file": "^4.1.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "test-exclude": "^8.0.0",
    "glob": "^13.0.0",
    "tar": "^7.5.21",
    "undici": "^6.26.1",
    "js-yaml": "^5.4.3",
    "brace-expansion": "^5.0.9"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/db/migrations_sequelize/**",
      "!src/swagger/**",
      "!src/server.js",
      "!src/modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 85,
        "lines": 83,
        "statements": 83
      }
    }
  }
}
